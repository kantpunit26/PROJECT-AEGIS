# ==============================================================================
# PROJECT AEGIS 2.0 — CONFIGURATION ENVIRONMENT
# Advanced Genomic Epidemiology & Intelligence System
# ==============================================================================

# Core System Information
PROJECT_NAME="PROJECT AEGIS 2.0"
ENVIRONMENT="development"
VERSION="2.0.0"
DEBUG=True
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# Authentication & Security
# WARNING: Generate a secure secret in production (e.g. `openssl rand -hex 32`)
SECRET_KEY="aegis_dev_secret_key_change_in_production_8941279841289412"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_secure_password_2026
POSTGRES_DB=aegis_db
DATABASE_URL=postgresql+psycopg2://aegis:aegis_secure_password_2026@localhost:5432/aegis_db
# Set USE_SQLITE_FALLBACK=True when running local standalone development without PostgreSQL
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=./data/aegis_local.db

# Background Task Worker (Redis & Celery)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# NCBI Datasets & Entrez Integration
NCBI_API_KEY=""
NCBI_EMAIL="aegis-surveillance@example.org"
NCBI_TOOL_NAME="AEGIS-2.0-AMR-Platform"

# Bioinformatics File Storage & Compute Paths
DATA_ROOT=./data
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
REFERENCE_DATA_PATH=./data/reference

# Surveillance & Alerting Thresholds
ALERT_THRESHOLD_SNP_DISTANCE=15
ALERT_THRESHOLD_OUTBREAK_CLUSTER_SIZE=3
ALERT_SPATIAL_CLUSTER_RADIUS_KM=25.0
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""

# Frontend Configuration
VITE_API_URL="http://localhost:8000/api/v1"

