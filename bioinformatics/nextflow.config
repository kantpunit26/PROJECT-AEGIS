// PROJECT AEGIS 2.0 — Nextflow Scientific Workflow Configuration

manifest {
    name            = 'AEGIS-2.0-Bioinformatics'
    author          = 'PROJECT AEGIS 2.0 Scientific Team'
    homePage        = 'https://github.com/aegis-surveillance/aegis-2.0'
    description     = 'Reproducible AMR Genomic Surveillance & Comparative Genomics Pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '2.0.0'
}

params {
    // Organism Reference
    organism            = "Klebsiella pneumoniae"
    reference_genome    = "${projectDir}/../data/reference/HS11286.fna"
    outdir              = "${projectDir}/../data/processed"
    
    // Quality Thresholds
    min_n50             = 30000
    max_contigs         = 500
    min_length          = 5000000
    max_length          = 6000000
    
    // AMRFinderPlus Options
    amrfinder_organism  = "Klebsiella_pneumoniae"
    ident_min           = 0.90
    coverage_min        = 0.50
    
    // IQ-TREE Parameters
    iqtree_model        = "GTR+F+R4"
    iqtree_bootstrap    = 1000
}

process {
    cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
    memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    time   = { check_max( 4.h * task.attempt, 'time' ) }

    errorStrategy = { task.exitStatus in [140,143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'AMRFINDER_PLUS' {
        container = 'ncbi/amr:3.12.8'
    }
    withName: 'KLEBORATE' {
        container = 'katholt/kleborate:v2.4.1'
    }
    withName: 'SNIPPY' {
        container = 'staphb/snippy:4.6.0'
    }
    withName: 'IQTREE' {
        container = 'staphb/iqtree2:2.2.6'
    }
    withName: 'MOBSUITE' {
        container = 'kbessonov/mob_suite:3.1.8'
    }
}

profiles {
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled          = true
    }
}

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}

